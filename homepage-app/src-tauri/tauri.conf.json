{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "homepage-app",
  "version": "0.1.0",
  "identifier": "com.johnson.homepage-app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "HomeKube",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": null,
      "allowNavigation": ["https://auth.johnsonyuen.com"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
